rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── receipts ───────────────────────────────────────────
    // Only admin can upload and read receipts
    match /receipts/{fileName} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ── verification documents ─────────────────────────────
    // Staff upload their own ID photos (front/back/selfie). Reviewers open
    // them through the tokenized download URLs stored on /verifications.
    match /verifications/{userId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || request.auth.token.admin == true
      );
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024  // max 10MB
        && request.resource.contentType.matches('image/.*');
    }

    // ── profile pictures ───────────────────────────────────
    // Users can upload their own profile picture
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024  // max 2MB
        && request.resource.contentType.matches('image/.*');
    }
  }
}
